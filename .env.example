# En Windows, el .env, la base, la configuración de Claude y el perfil de Fiwind
# van en %LOCALAPPDATA%\FinancialAgent, fuera de OneDrive. Rutas de ejemplo:
#   DB_PATH=C:\Users\<usuario>\AppData\Local\FinancialAgent\financial_agent.db
#   CLAUDE_CONFIG_DIR=C:\Users\<usuario>\AppData\Local\FinancialAgent\claude
#   FIWIND_PROFILE_DIR=C:\Users\<usuario>\AppData\Local\FinancialAgent\browser\fiwind
# Token del bot de Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
# ID numérico de Telegram del dueño (único usuario autorizado)
TELEGRAM_OWNER_ID=
# Token generado con `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Ruta de la base SQLite (relativa al directorio de trabajo)
DB_PATH=data/financial_agent.db
# Directorio de configuración de Claude Code
CLAUDE_CONFIG_DIR=data/claude
# Directorio de trabajo del agente
AGENT_CWD=data/agent
# Modelo de Claude
CLAUDE_MODEL=claude-sonnet-5-5
# Minutos de inactividad antes de cerrar la sesión
SESSION_IDLE_MINUTES=30
# Zona horaria para mostrar fechas
TZ=America/Argentina/Buenos_Aires
# Nivel de logs
LOG_LEVEL=INFO
# Perfil del navegador de Fiwind (vacío: %LOCALAPPDATA%\FinancialAgent\browser\fiwind, o data/browser/fiwind)
FIWIND_PROFILE_DIR=
# Mostrar el navegador al operar Fiwind (1, true o si); vacío: oculto
FIWIND_HEADED=
# Ruta del ejecutable agent-browser si no está en el PATH
AGENT_BROWSER_BIN=
# Hora (1 a 23) a la que corren las rutinas mensuales
ROUTINE_HOUR=10
